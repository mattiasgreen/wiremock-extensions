{
  "credential-and-loop-guard": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pre-command-guard.ps1",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
