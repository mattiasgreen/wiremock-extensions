<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude internal representation exposure for DTOs, options, and records returning Map/List -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Exclude Unicode normalization requirement for protocol strings, HTTP methods, and identifiers -->
    <Match>
        <Bug pattern="IMPROPER_UNICODE"/>
    </Match>

    <!-- Exclude raw unencrypted TCP socket warnings and simulation pseudorandomness for tcp-netem -->
    <Match>
        <Package name="~com\.github\.mattiasgreen\.wiremock\.netem\..*"/>
        <Bug pattern="UNENCRYPTED_SERVER_SOCKET,UNENCRYPTED_SOCKET,PREDICTABLE_RANDOM"/>
    </Match>

    <!-- Exclude singleton instance exposure for registries -->
    <Match>
        <Class name="com.github.mattiasgreen.wiremock.netem.engine.TcpNetEmRegistry"/>
        <Bug pattern="MS_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="com.github.mattiasgreen.wiremock.casual.CasualRegistry"/>
        <Bug pattern="MS_EXPOSE_REP"/>
    </Match>

    <!-- Exclude browser launcher and local file operations in desktop client WireMockStudio -->
    <Match>
        <Class name="com.github.mattiasgreen.wiremock.ui.WireMockStudio"/>
        <Bug pattern="PATH_TRAVERSAL_IN,COMMAND_INJECTION"/>
    </Match>

    <!-- Exclude CLI file reading operations for CasualClient -->
    <Match>
        <Class name="se.laz.casual.client.CasualClient"/>
        <Bug pattern="PATH_TRAVERSAL_IN"/>
    </Match>

    <!-- Exclude subprocess launcher for WireMockConsoleProxy in CLI runner -->
    <Match>
        <Class name="com.github.mattiasgreen.wiremock.cli.WireMockCli"/>
        <Bug pattern="COMMAND_INJECTION"/>
    </Match>

    <!-- Exclude CRLF log injection warnings for raw protocol frames and hex dumps in casual extension -->
    <Match>
        <Package name="~se\.laz\.casual\..*"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <Match>
        <Class name="com.github.mattiasgreen.wiremock.casual.CasualWireMockGateway"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <!-- Exclude reflection setAccessible for dynamic field table reloading in casual extension -->
    <Match>
        <Class name="se.laz.casual.api.buffer.CasualBufferUtils"/>
        <Bug pattern="DP_DO_INSIDE_DO_PRIVILEGED"/>
    </Match>
</FindBugsFilter>
