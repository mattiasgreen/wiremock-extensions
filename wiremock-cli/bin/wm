#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLI_JAVA="${SCRIPT_DIR}/../src/main/java/com/github/mattiasgreen/wiremock/cli/WireMockCli.java"
if [[ ! -f "$CLI_JAVA" ]]; then
    CLI_JAVA="${SCRIPT_DIR}/../WireMockCli.java"
fi

exec java "$CLI_JAVA" "$@"
